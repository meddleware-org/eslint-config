// TypeScript settings for type-checking (`npm run type-check`). The package is plain JavaScript with JSDoc types, so
// TypeScript checks src/index.js (`checkJs`) and the fixture tests, and emits nothing; tsconfig.build.json extends this file
// to emit the declarations.
{
  "compilerOptions": {
    // Node 26 runs everything this package is used in (ESLint, the consumers' builds), so no down-levelling is needed.
    "target": "esnext",
    "module": "esnext",
    "moduleResolution": "Bundler",
    // The source is JavaScript: allow it and check it against its JSDoc types.
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    // Do not type-check the dependencies' own declaration files: their correctness is not this package's to prove.
    "skipLibCheck": true,
    // Only Node's globals; the tests run in Node.
    "types": ["node"],
    "noEmit": true
  },
  "include": ["src/**/*.js", "tests/**/*.ts"]
}
