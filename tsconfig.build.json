// Build settings (`npm run build`): emit dist/index.d.ts from the JSDoc types in src/index.js, so TypeScript consumers get
// types. Only declarations are emitted: consumers load src/index.js itself (package.json `exports`).
{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    // dist/ mirrors src/ (index.js → index.d.ts).
    "rootDir": "./src",
    "declarationDir": "./dist"
  },
  // The tests are type-checked but never emitted.
  "include": ["src/**/*.js"]
}
